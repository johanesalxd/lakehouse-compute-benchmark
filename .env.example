# Copy to .env and adjust before provisioning or running notebooks.
# Never commit .env with real project IDs or credentials.

export PROJECT_ID="your-gcp-project-id"
export PROJECT_NUMBER=""

# Location alignment:
# - Default US multi-region keeps bigquery-public-data.tpc_ds_* 100% zero-egress across all 3 scales
#   (small_1g, medium_100g, large_500g).
# - For org policies restricting resource locations to a single region (e.g. asia-southeast1 or
#   us-central1), set all 4 variables below to that region and keep SCALE_PRESET="small_1g".
export BQ_LOCATION="US"
export GCS_LOCATION="${BQ_LOCATION}"
export DATAPROC_REGION="us-central1"
export DATAPROC_ZONE="us-central1-a"

# Storage bucket for open Parquet / Iceberg medallion layers (auto-defaults to lakehouse-bench-${PROJECT_NUMBER} if blank)
export BENCH_BUCKET=""

# Dataset scale preset:
#   small_1g    -> bigquery-public-data.tpc_ds_1g (~1 GB logical / ~250 MiB Parquet; works in US & non-US)
#   medium_100g -> slices ~18 days of bigquery-public-data.tpc_ds_10t (~100 GB; requires BQ_LOCATION="US")
#   large_500g  -> slices ~90 days of bigquery-public-data.tpc_ds_10t (~500 GB; requires BQ_LOCATION="US")
export SCALE_PRESET="small_1g"

# VPC networking & Private Google Access (no Cloud NAT; never modifies 'default' unless --subnet=default)
export BENCH_NETWORK="bench-vpc"
# Leave blank to auto-create bench-pga-${DATAPROC_REGION}, or set an existing subnet name
export BENCH_SUBNET=""
export BENCH_SUBNET_CIDR="10.20.0.0/24"

# Dedicated least-privilege Dataproc runner SA & automatic idle/age termination
export DATAPROC_SA_NAME="bench-dataproc-runner"
export CLUSTER_MAX_IDLE="30m"
export CLUSTER_MAX_AGE="4h"

# Dataproc on Compute Engine (x86) cluster sizing (identical hardware for Standard vs Lightning)
export DATAPROC_IMAGE_VERSION="2.3-debian12"
export CLUSTER_STD_NAME="bench-spark-std-x86"
export CLUSTER_LGT_NAME="bench-spark-lightning-x86"
export MASTER_MACHINE_TYPE="n2d-standard-4"
export WORKER_MACHINE_TYPE="n2d-standard-8"
export NUM_PRIMARY_WORKERS="2"
export NUM_WORKER_LOCAL_SSDS="1"

# BigQuery Enterprise Edition reservation & hard on-demand guardrails
# Set Reservation Admin Project (can be same as PROJECT_ID in a standalone sandbox)
# Set BQ_BASELINE_SLOTS=BQ_SLOT_CAP (e.g., 200) for fixed baseline capacity with 0 autoscale
# Leave BIGLAKE_CONNECTION_ID blank to auto-derive bench-biglake-<bq_location_lower>
export BQ_ADMIN_PROJECT_ID=""
export BQ_RESERVATION_NAME="bench-elt-slots"
export BQ_BASELINE_SLOTS="0"
export BQ_SLOT_CAP="100"
export BIGLAKE_CONNECTION_ID=""

# BigQuery dataset names (created in BQ_LOCATION)
export DS_BRONZE_NATIVE="bench_bronze_native"
export DS_BRONZE_BIGLAKE="bench_bronze_biglake"
export DS_SILVER_BQ="bench_silver_bq"
export DS_GOLD_BQ="bench_gold_bq"
export DS_METRICS="bench_metrics"

# Optional toggle for Stage 2B scalar Python UDF comparison (bounded sample on medium/large scales)
export RUN_PYTHON_UDF_STAGE="true"
export UDF_MAX_SAMPLE_ROWS="500000"

# Optional TCO pricing override for Notebook 04 (defaults to DATAPROC_REGION / BQ_LOCATION;
# supported presets: US, us-central1, asia-southeast1; PRICING_* env vars also override individual rates)
export PRICING_REGION=""
